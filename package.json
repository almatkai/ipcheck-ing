{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "ipcheck-ing",
  "title": "IPCheck",
  "description": "Show your local and external IPs from multiple sources, look up the location and network behind any IP address, and keep your current IP in the menu bar",
  "icon": "ipchecking.png",
  "author": "almatkai",
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "preferences": [
    {
      "type": "checkbox",
      "name": "getLocalIPs",
      "title": "Local IPs",
      "description": "Get Local IPs",
      "label": "Get Local IPs",
      "default": true,
      "required": false
    },
    {
      "type": "checkbox",
      "name": "getIPFromCloudflare_V4",
      "title": "External IP Sources to Fetch",
      "description": "Fetch IP from CloudFlare IPv4",
      "label": "CloudFlare IPv4",
      "default": true,
      "required": false
    },
    {
      "type": "checkbox",
      "name": "getIPFromCloudflare_V6",
      "description": "Fetch IP from CloudFlare IPv6",
      "label": "CloudFlare IPv6",
      "default": true,
      "required": false
    },
    {
      "type": "checkbox",
      "name": "getIPFromIPCheck4",
      "description": "Fetch IP from IPCheck.ing IPv4",
      "label": "IPCheck.ing IPv4",
      "default": true,
      "required": false
    },
    {
      "type": "checkbox",
      "name": "getIPFromIPCheck6",
      "description": "Fetch IP from IPCheck.ing IPv6",
      "label": "IPCheck.ing IPv6",
      "default": true,
      "required": false
    },
    {
      "type": "checkbox",
      "name": "getIPFromIPCheck64",
      "description": "Fetch IP from IPCheck.ing DualStack — shows which protocol your network prefers",
      "label": "IPCheck.ing DualStack",
      "default": true,
      "required": false
    }
  ],
  "commands": [
    {
      "name": "main",
      "title": "Show My IPs",
      "subtitle": "IPCheck",
      "description": "Show All My IPs",
      "mode": "view",
      "keywords": [
        "ip",
        "my ip",
        "public ip",
        "external ip",
        "local ip",
        "ipv4",
        "ipv6",
        "what is my ip"
      ],
      "platforms": [
        "macOS",
        "Windows"
      ]
    },
    {
      "name": "query-ip",
      "title": "Query IP",
      "subtitle": "IPCheck",
      "description": "Look up the location, ISP and network behind any IP address",
      "mode": "view",
      "keywords": [
        "query ip",
        "search ip",
        "lookup ip",
        "ip lookup",
        "ip info",
        "geoip",
        "ip location",
        "ipv4",
        "ipv6"
      ],
      "arguments": [
        {
          "name": "ip",
          "placeholder": "IP address",
          "type": "text",
          "required": false
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ]
    },
    {
      "name": "menubar",
      "title": "IP in Menu Bar",
      "subtitle": "IPCheck",
      "description": "Keep your current external IP in the menu bar",
      "mode": "menu-bar",
      "interval": "5m",
      "preferences": [
        {
          "type": "dropdown",
          "name": "preferredSource",
          "title": "IP Source",
          "description": "Which service to ask for the external IP shown in the menu bar",
          "default": "getIPFromIPCheck4",
          "required": false,
          "data": [
            {
              "title": "IPCheck.ing IPv4",
              "value": "getIPFromIPCheck4"
            },
            {
              "title": "IPCheck.ing IPv6",
              "value": "getIPFromIPCheck6"
            },
            {
              "title": "IPCheck.ing DualStack",
              "value": "getIPFromIPCheck64"
            },
            {
              "title": "Cloudflare IPv4",
              "value": "getIPFromCloudflare_V4"
            },
            {
              "title": "Cloudflare IPv6",
              "value": "getIPFromCloudflare_V6"
            }
          ]
        },
        {
          "type": "dropdown",
          "name": "labelStyle",
          "title": "Menu Bar Label",
          "description": "How much to show next to the menu bar icon",
          "default": "flagAndIp",
          "required": false,
          "data": [
            {
              "title": "Flag and IP",
              "value": "flagAndIp"
            },
            {
              "title": "Flag Only",
              "value": "flag"
            },
            {
              "title": "IP Only",
              "value": "ip"
            },
            {
              "title": "Icon Only",
              "value": "hidden"
            }
          ]
        },
        {
          "type": "checkbox",
          "name": "compactIPv6",
          "title": "IPv6 Display",
          "description": "When the label shows an IPv6 address, display only its first two segments to save menu bar space",
          "label": "Shorten IPv6 addresses in the menu bar",
          "default": false,
          "required": false
        },
        {
          "type": "dropdown",
          "name": "refreshEvery",
          "title": "Refresh Every",
          "description": "How often to check for a new external IP in the background",
          "default": "10",
          "required": false,
          "data": [
            {
              "title": "5 minutes",
              "value": "5"
            },
            {
              "title": "10 minutes",
              "value": "10"
            },
            {
              "title": "20 minutes",
              "value": "20"
            },
            {
              "title": "30 minutes",
              "value": "30"
            },
            {
              "title": "60 minutes",
              "value": "60"
            }
          ]
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "^2.2.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "id": "com.tezbar.ipcheck-ing",
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/ipcheck-ing",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/ipcheck-ing",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
